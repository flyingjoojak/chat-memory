{
  "name": "engram-desktop",
  "version": "0.1.0",
  "description": "Engram 데스크탑 앱 (Electron 셸 + 파이썬 사이드카)",
  "main": "main.js",
  "author": "flyingjoojak",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.0"
  },
  "build": {
    "appId": "com.engram.app",
    "productName": "Engram",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "icon": "icon.png",
    "files": ["main.js", "preload.js", "loading.html", "icon.png"],
    "extraResources": [
      { "from": "../dist/chatmem-backend", "to": "backend" }
    ],
    "win": { "target": ["nsis", "zip"], "icon": "icon.png" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity", "icon": "icon.png" },
    "linux": { "target": "AppImage", "category": "Utility", "icon": "icon.png" },
    "publish": [
      { "provider": "github", "owner": "flyingjoojak", "repo": "chat-memory" }
    ]
  }
}
